<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="10dp"
    android:paddingEnd="10dp" android:paddingTop="7dp"
    android:paddingBottom="7dp">
    <TextView android:id="@+id/messageRole" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp"
        android:letterSpacing=".12" android:textStyle="bold"
        android:textColor="@color/muted" android:layout_marginBottom="5dp"/>
    <TextView android:id="@+id/messageText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minWidth="78dp" android:maxWidth="315dp"
        android:padding="15dp" android:textSize="14sp" android:textColor="@color/ink"
        android:textIsSelectable="true" android:lineSpacingExtra="3dp"
        android:background="@drawable/bg_assistant"/>
</LinearLayout>
