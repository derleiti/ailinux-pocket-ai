<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="19dp" android:paddingBottom="12dp">
        <TextView android:layout_width="47dp" android:layout_height="47dp"
            android:gravity="center" android:text="◈" android:textSize="32sp"
            android:textColor="@color/primary" android:background="@drawable/bg_panel"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="13dp"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="POCKET AI" android:letterSpacing=".15" android:textSize="19sp"
                android:textStyle="bold" android:textColor="@color/ink"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AILinux • LOCAL INTELLIGENCE" android:letterSpacing=".07"
                android:textColor="@color/muted" android:textSize="9sp"/>
        </LinearLayout>
        <TextView android:id="@+id/onlineChip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="9dp"
            android:text="●  AGENT AUS" android:letterSpacing=".06" android:textSize="10sp"
            android:textStyle="bold" android:textColor="@color/primary"
            android:background="@drawable/bg_panel"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout android:id="@+id/chatPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical">
            <!-- CHAT is for talking only. Model installation/switching lives under MODELLE. -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="13dp" android:paddingBottom="13dp">
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GESPRÄCH" android:letterSpacing=".16"
                        android:textStyle="bold" android:textSize="10sp"
                        android:textColor="@color/muted"/>
                    <TextView android:id="@+id/chatModelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Kein Modell geladen"
                        android:textColor="@color/ink" android:textSize="13sp"
                        android:textStyle="bold" android:maxLines="1"
                        android:ellipsize="middle"/>
                </LinearLayout>
                <TextView android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:maxWidth="120dp"
                    android:gravity="end"
                    android:text="Warte auf Modell"
                    android:textColor="@color/muted" android:textSize="11sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatMcpButton"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:text="MCP" android:textAllCaps="false"
                    android:textSize="10sp" android:minWidth="48dp"
                    android:textColor="@color/ink"
                    app:backgroundTint="@color/surface_raised"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chatMessages" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingBottom="12dp"/>
                <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:gravity="center"
                    android:padding="24dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✦" android:textSize="42sp" android:textColor="@color/secondary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Deine Ideen. Dein Gerät."
                        android:textStyle="bold" android:textSize="17sp" android:textColor="@color/ink"/>
                    <TextView android:id="@+id/emptyHint"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Unter MODELLE ein GGUF auswählen und laden."
                        android:gravity="center" android:textSize="12sp"
                        android:textColor="@color/muted"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom|center_vertical"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                android:layout_marginTop="7dp" android:layout_marginBottom="12dp"
                android:padding="7dp" android:background="@drawable/bg_entry">
                <EditText android:id="@+id/messageInput" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:paddingStart="11dp" android:paddingEnd="8dp"
                    android:paddingTop="9dp" android:paddingBottom="9dp"
                    android:background="@android:color/transparent"
                    android:hint="Frag deine lokale KI..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4" android:minHeight="45dp"
                    android:textColor="@color/ink" android:textColorHint="@color/muted"
                    android:textSize="14sp" android:imeOptions="actionSend"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton" android:layout_width="65dp"
                    android:layout_height="47dp" android:minWidth="0dp"
                    android:layout_gravity="bottom" android:text="➤"
                    android:textSize="20sp" android:textColor="@color/background"
                    app:cornerRadius="16dp" app:backgroundTint="@color/primary"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/libraryPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone"
            android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="19dp"
                android:paddingEnd="19dp" android:paddingTop="22dp" android:paddingBottom="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Deine Modellbibliothek" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="26sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="GGUF-Modelle lokal speichern, wechseln und offline ausführen."
                    android:textColor="@color/muted" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="17dp"
                    android:layout_marginTop="19dp" android:background="@drawable/bg_hero">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="MODELL IMPORTIEREN" android:letterSpacing=".15"
                        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/primary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importButton" android:layout_width="match_parent"
                        android:layout_height="49dp" android:layout_marginTop="10dp"
                        android:text="↗   GGUF-Datei auswählen" android:textAllCaps="false"
                        android:textColor="@color/background" app:backgroundTint="@color/primary"
                        app:cornerRadius="13dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/browseButton" android:layout_width="match_parent"
                        android:layout_height="49dp" android:layout_marginTop="5dp"
                        android:text="⌕   GitHub / Hugging Face durchsuchen" android:textAllCaps="false"
                        android:textColor="@color/ink" app:backgroundTint="@color/surface_raised"
                        app:cornerRadius="13dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickStartButton" android:layout_width="match_parent"
                        android:layout_height="49dp" android:layout_marginTop="5dp"
                        android:text="✦   Kleine Modelle entdecken" android:textAllCaps="false"
                        android:textColor="@color/ink" app:backgroundTint="@color/surface_raised"
                        app:cornerRadius="13dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/urlButton" android:layout_width="match_parent"
                        android:layout_height="49dp" android:layout_marginTop="5dp"
                        android:text="↓   Direkten GGUF-Link laden" android:textAllCaps="false"
                        android:textColor="@color/ink" app:backgroundTint="@color/surface_raised"
                        app:cornerRadius="13dp"/>
                    <TextView android:id="@+id/downloadStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:textColor="@color/muted" android:textSize="11sp"/>
                    <ProgressBar android:id="@+id/downloadProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="5dp"
                        android:layout_marginTop="9dp" android:visibility="gone"
                        android:progressTint="@color/primary"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelDownload" android:layout_width="match_parent"
                        android:layout_height="42dp" android:visibility="gone"
                        android:text="Download abbrechen" android:textAllCaps="false"
                        android:textColor="@color/warn" app:backgroundTint="@color/surface_raised"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/modelLoadingPanel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:padding="15dp"
                    android:visibility="gone" android:orientation="horizontal"
                    android:gravity="center_vertical" android:background="@drawable/bg_panel">
                    <ProgressBar android:layout_width="32dp" android:layout_height="32dp"
                        android:indeterminate="true" android:indeterminateTint="@color/primary"/>
                    <TextView android:id="@+id/modelLoadingLabel"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Initialisiere GGUF-Modell. Das kann etwas dauern …"
                        android:textColor="@color/ink" android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:layout_marginTop="27dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="INSTALLIERTE MODELLE"
                        android:letterSpacing=".13" android:textStyle="bold"
                        android:textSize="11sp" android:textColor="@color/muted"/>
                    <TextView android:id="@+id/storageLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/muted"
                        android:textSize="11sp" android:text="0 Modelle"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/modelsContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="10dp"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/settingsPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Feineinstellungen" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="26sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="LOKALE INFERENZ"
                    android:letterSpacing=".15" android:textColor="@color/primary"
                    android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="25dp" android:text="System-Prompt"
                    android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                <EditText android:id="@+id/systemPromptInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:padding="18dp"
                    android:gravity="top" android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" android:maxLines="6"
                    android:textSize="13sp" android:textColor="@color/ink"
                    android:background="@drawable/bg_panel"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/thinkingModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="45dp"
                    android:checked="false"
                    android:text="Denkmodus aktivieren"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:thumbTint="@color/primary"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Standard: AUS. Thinking wirkt nach Modell-Neuladen und beeinflusst nur die lokale Modellausgabe. Es aktiviert weder MCP-Zugriff noch Werkzeuge. Für Toolaufrufe: CHAT → MCP → KI + MCP aktivieren; jede Ausführung einzeln bestätigen."
                    android:textSize="12sp"
                    android:textColor="@color/muted"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="23dp" android:text="Maximale Antwortlänge"
                    android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                <Spinner android:id="@+id/maxTokensSpinner"
                    android:layout_width="match_parent" android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="25dp" android:text="SAMPLING · ANTWORTVERHALTEN"
                    android:letterSpacing=".12" android:textStyle="bold"
                    android:textColor="@color/primary" android:textSize="12sp"/>
                <Spinner android:id="@+id/samplingPresetSpinner"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Temperature" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/temperatureInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="0.00 bis 2.00 · Kreativität" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Top-K" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/topKInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="1 bis 200 · Kandidatenauswahl" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Top-P" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/topPInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="0.05 bis 1.00 · Wahrscheinlichkeitsmasse" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Min-P" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/minPInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="0.00 bis 0.50 · Mindestwahrscheinlichkeit" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Repeat Penalty" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/repeatPenaltyInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="1.00 bis 2.00 · Wiederholungen bremsen" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Repeat Last N" android:textStyle="bold"
                    android:textColor="@color/ink" android:textSize="14sp"/>
                <EditText android:id="@+id/repeatLastNInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="5dp"
                    android:inputType="numberDecimal" android:singleLine="true"
                    android:hint="0 bis 512 · Verlauf in Tokens" android:padding="12dp"
                    android:textColor="@color/ink" android:background="@drawable/bg_panel"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveSettingsButton" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="18dp"
                    android:text="Einstellungen speichern" android:textAllCaps="false"
                    android:textColor="@color/background" app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearChatButton" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="24dp"
                    android:text="Gespräch zurücksetzen" android:textAllCaps="false"
                    android:textColor="@color/ink" app:backgroundTint="@color/surface_raised"
                    app:cornerRadius="14dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Sicherer CPU-Modus · 2.048 Kontext-Tokens · Batch 128"
                    android:textColor="@color/muted" android:textSize="12sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crashDiagnosticsButton"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:text="Letzte App-Abstürze prüfen" android:textAllCaps="false"
                    android:textColor="@color/ink" app:backgroundTint="@color/surface_raised"
                    app:cornerRadius="14dp"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="MCP VERBINDUNGEN" android:letterSpacing=".15"
                    android:textColor="@color/primary"
                    android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Streamable HTTP: Ohne Auth, Bearer, API-Key, Basic und OAuth mit PKCE. Zugangsdaten werden mit Android Keystore verschlüsselt."
                    android:textColor="@color/muted" android:textSize="12sp"/>
                <!-- RC12: MCP model-agent settings must be reachable from SETUP,
                     not hidden exclusively in CHAT -> MCP. -->
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="MCP MODELL-AGENT · AUTO-BRIDGE"
                    android:textColor="@color/primary"
                    android:letterSpacing=".12" android:textStyle="bold"
                    android:textSize="12sp"/>
                <TextView android:id="@+id/mcpAgentSettingsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MCP-Agent AUS · Werkzeug-Discovery noch nicht aktiviert"
                    android:textColor="@color/ink" android:textSize="13sp"
                    android:contentDescription="Aktueller MCP-Modell-Agentenstatus"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="MCP-Server hier anmelden, darunter den Modell-Agenten konfigurieren. AUTO-BRIDGE lässt das lokale GGUF echte Tools suchen. Für Ausführungen ist immer deine Freigabe nötig. Auch ohne geladenes Modell kannst du den Agenten vormerken und die Live-Toolliste ansehen."
                    android:textColor="@color/muted" android:textSize="12sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mcpAgentSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="KI + MCP / AUTO-BRIDGE konfigurieren"
                    android:textAllCaps="false"
                    android:textColor="@color/background"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mcpToolListSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="MCP-Tools live prüfen (ohne Modell)"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    app:backgroundTint="@color/surface_raised"
                    app:cornerRadius="14dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addMcpServerButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="+ MCP-Server hinzufügen"
                    android:textAllCaps="false"
                    android:textColor="@color/background"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"/>
                <LinearLayout android:id="@+id/mcpServerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tools werden nur nach deiner ausdrücklichen Bestätigung ausgeführt. OAuth-Anmeldung erfolgt im externen Browser."
                    android:textColor="@color/muted" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="Wichtig: Normale App-Updates erhalten Modelle und Anmeldungen. Das Löschen der App-Daten oder eine Deinstallation entfernt dagegen die privaten GGUF-Dateien und den verschlüsselten MCP-Tresor."
                    android:textColor="@color/muted" android:textSize="11sp"/>
                <TextView android:id="@+id/appVersion"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="AILinux Pocket AI"
                    android:textColor="@color/muted" android:textSize="12sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Die KI läuft direkt auf deinem Gerät mit llama.cpp. Nur Modell-Downloads und Repository-Abfragen benötigen Internet."
                    android:textColor="@color/muted" android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="67dp"
        android:orientation="horizontal" android:paddingStart="20dp"
        android:paddingEnd="20dp" android:paddingTop="7dp" android:paddingBottom="8dp"
        android:background="@color/surface" android:gravity="center">
        <TextView android:id="@+id/navChat" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
